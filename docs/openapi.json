{
  "openapi": "3.1.0",
  "info": {
    "title": "海洋大學地端 AI 總機分類服務",
    "description": "本機分類與最多兩次澄清；不回答業務問題。",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/classify": {
      "post": {
        "tags": [
          "classification"
        ],
        "summary": "Classify",
        "operationId": "classify_api_v1_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          },
          "404": {
            "description": "Conversation not found"
          },
          "409": {
            "description": "State or request conflict"
          },
          "410": {
            "description": "Conversation expired"
          },
          "413": {
            "description": "Body too large"
          },
          "422": {
            "description": "Invalid request or context too long"
          },
          "429": {
            "description": "Queue full or timed out"
          },
          "502": {
            "description": "Invalid model output"
          },
          "503": {
            "description": "Model or storage unavailable"
          },
          "504": {
            "description": "Inference timed out"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ClassifyRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version",
            "default": 0
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "message"
        ],
        "title": "ClassifyRequest"
      },
      "ClassifyResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "CLASSIFIED",
              "NEEDS_CLARIFICATION",
              "UNKNOWN"
            ],
            "title": "Status"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "clarification_count": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Clarification Count"
          },
          "clarification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Question"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "RULE_MATCH",
              "SEMANTIC_MATCH",
              "INSUFFICIENT_INFORMATION",
              "MULTIPLE_DOMAINS",
              "OUT_OF_SCOPE",
              "CLARIFICATION_LIMIT"
            ],
            "title": "Reason Code"
          },
          "is_final": {
            "type": "boolean",
            "title": "Is Final"
          },
          "config_version": {
            "type": "string",
            "title": "Config Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "conversation_id",
          "version",
          "status",
          "domain",
          "clarification_count",
          "clarification",
          "reason_code",
          "is_final",
          "config_version"
        ],
        "title": "ClassifyResponse"
      },
      "Question": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "title": "Question"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
