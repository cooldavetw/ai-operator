# Generate without Python: openssl rand -hex 32
API_KEY=replace-with-a-random-secret
BIND_ADDRESS=127.0.0.1
PORT=8000
MODEL_SHA256=
# Leave blank only if the GGUF contains a compatible tokenizer.chat_template.
CHAT_FORMAT=
N_THREADS=4
N_CTX=4096
MAX_TOKENS=192
TEMPERATURE=0
INFERENCE_TIMEOUT_SECONDS=30
STARTUP_TIMEOUT_SECONDS=180
QUEUE_TIMEOUT_SECONDS=30
QUEUE_CAPACITY=8
EXPIRED_RETENTION_SECONDS=86400
MEM_LIMIT=16g
CPU_LIMIT=8
